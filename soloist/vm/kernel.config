# Spotifast's Soloist machine: what it needs on top of `make tinyconfig`.
# One QEMU `pc` machine, one CPU, virtio devices only, run by WHPX or TCG.
CONFIG_64BIT=y
CONFIG_LOCALVERSION="-spotifast"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEFAULT_HOSTNAME="spotifast"
# Faster to unpack than tinyconfig's XZ for a few hundred KB more.
CONFIG_KERNEL_ZSTD=y
# CONFIG_KERNEL_XZ is not set
# CONFIG_MODULES is not set
# CONFIG_SMP is not set

# Platform and timekeeping.
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_ACPI=y
CONFIG_X86_TSC=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_HYPERV=y
CONFIG_HYPERV_TIMER=y
# CONFIG_HYPERV_UTILS is not set
# CONFIG_HYPERV_BALLOON is not set
CONFIG_KVM_GUEST=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_HZ_250=y
CONFIG_CPU_IDLE=y
# CONFIG_ACPI_AC is not set
# CONFIG_ACPI_BATTERY is not set
# CONFIG_ACPI_BUTTON is not set
# CONFIG_ACPI_FAN is not set
# CONFIG_ACPI_THERMAL is not set
# CONFIG_ACPI_TABLE_UPGRADE is not set
# With hpet=off, the ACPI PM timer is the reference the TSC is calibrated
# against when the PIT is too noisy, as it is under TCG: without it the
# kernel marks the TSC unstable and keeps time with jiffies.
CONFIG_X86_PM_TIMER=y

# Devices: virtio over PCI.
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y
# CONFIG_ETHERNET is not set
# CONFIG_WLAN is not set
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
# Network buffers ask for 32 KB runs, which a long-running machine keeps
# finding only if Linux can move pages around.
CONFIG_COMPACTION=y

# Boot and file systems. The initramfs is plain newc cpio.
CONFIG_BLK_DEV_INITRD=y
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
CONFIG_DEVTMPFS=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_SHMEM=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_CRYPTO_CRC32C=y

# Console and diagnostics.
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_EARLY_PRINTK=y
CONFIG_BUG=y

# Network.
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
# CONFIG_IPV6_SIT is not set
CONFIG_UNIX=y
# CONFIG_PACKET is not set
# CONFIG_NETFILTER is not set
# CONFIG_WIRELESS is not set

# What a threaded glibc 2.41 program with an event loop calls.
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_RT_MUTEXES=y
CONFIG_FUTEX_PI=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_INOTIFY_USER=y
# CONFIG_FANOTIFY is not set
CONFIG_AIO=y
CONFIG_IO_URING=y
CONFIG_POSIX_TIMERS=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_RSEQ=y
CONFIG_MEMFD_CREATE=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_FHANDLE=y
CONFIG_FILE_LOCKING=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
# CONFIG_CRYPTO_USER_API_HASH is not set
# CONFIG_CRYPTO_USER_API_SKCIPHER is not set
# CONFIG_SWAP is not set
# CONFIG_AUDIT is not set
# CONFIG_SECURITY is not set
# CONFIG_SOUND is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_DRM is not set
# CONFIG_DEBUG_INFO is not set

# Defaults that tinyconfig plus the lines above would turn on and the
# machine has no use for: it has no keyboard, screen, sensors or partitions.
# CONFIG_INPUT is not set
# CONFIG_SERIO is not set
# CONFIG_HYPERV_KEYBOARD is not set
# CONFIG_VT is not set
# CONFIG_HID_SUPPORT is not set
# CONFIG_LEGACY_PTYS is not set
# CONFIG_LEGACY_TIOCSTI is not set
# CONFIG_LDISC_AUTOLOAD is not set
# CONFIG_HW_RANDOM_INTEL is not set
# CONFIG_HW_RANDOM_AMD is not set
# CONFIG_HW_RANDOM_VIA is not set
# The ACPI processor driver selects THERMAL; QEMU's pc machine declares no
# C-states or P-states, so the CPU halts through the default idle loop.
# CONFIG_ACPI_PROCESSOR is not set
# CONFIG_THERMAL is not set
# CONFIG_INTEL_MEI is not set
# CONFIG_PERF_EVENTS_INTEL_UNCORE is not set
# CONFIG_PERF_EVENTS_INTEL_RAPL is not set
# CONFIG_PERF_EVENTS_INTEL_CSTATE is not set
# CONFIG_PCIEASPM is not set
# CONFIG_VGA_ARB is not set
# CONFIG_PNP_DEBUG_MESSAGES is not set
# CONFIG_INET_DIAG is not set
# CONFIG_ETHTOOL_NETLINK is not set
# CONFIG_MQ_IOSCHED_KYBER is not set
CONFIG_PARTITION_ADVANCED=y
# CONFIG_MSDOS_PARTITION is not set
# CONFIG_EFI_PARTITION is not set
# CONFIG_BLOCK_LEGACY_AUTOLOAD is not set
# KVM's halt polling spins the guest before it sleeps; an idle machine
# should cost the host nothing.
# CONFIG_HALTPOLL_CPUIDLE is not set
# CONFIG_CPU_IDLE_GOV_HALTPOLL is not set
# 16 KB of kernel log instead of 128 KB.
CONFIG_LOG_BUF_SHIFT=14
# Read-only data is the one part of the image that is not padded to 2 MB:
# file names in BUG reports, error names, quirks for real PC chipsets.
# CONFIG_DEBUG_BUGVERBOSE is not set
# CONFIG_SYMBOLIC_ERRNAME is not set
# CONFIG_PCI_QUIRKS is not set
# One 1 KB CRC32 table per polynomial instead of eight: ext2 without
# metadata checksums and virtio never hash much.
CONFIG_CRC32_SARWATE=y
# CONFIG_CRC32_SLICEBY8 is not set
# The TCP port perturbation table: 4 KB instead of 256 KB at boot.
CONFIG_INET_TABLE_PERTURB_ORDER=10
